{
  "permissions": {
    "allow": [
      "Bash(.verify/bin/qdrant-v1.15.5-*/qdrant:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude",
        "ref": "v0.9.102"
      }
    }
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_bstack.py\""
          }
        ]
      }
    ]
  }
}
