# Copy this file to .env in the repo root: cp .env.example .env
# Docker Compose reads .env and passes these to the api, the worker and migrate.
# git ignores .env, so your keys stay out of the repo. A variable that is unset or
# commented out keeps the app's default. docs/manual-testing.md says what each does.
# Restart the stack after a change: docker compose up -d --wait

# Provider keys. The live providers embed with OpenAI, and the default chat models
# answer with Anthropic and OpenAI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for chat models of these providers, added in LIBRAG_CHAT_MODELS.
# GEMINI_API_KEY=
# XAI_API_KEY=

# Ports on your machine.
# LIBRAG_PORT=8000
# LIBRAG_QDRANT_PORT=6333

# Feature switches: on or off.
# LIBRAG_REINDEX_ENABLED=off
# LIBRAG_QUERY_REWRITE=on
# LIBRAG_DECOMPOSE=off
# LIBRAG_ENRICHMENT=off

# Models.
# LIBRAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# LIBRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# LIBRAG_CHAT_MODELS=anthropic/claude-sonnet-5-5=Claude Sonnet 5.5,openai/gpt-6.1-terra=GPT 6.1 Terra
# LIBRAG_CHAT_DEFAULT_MODEL=anthropic/claude-sonnet-5-5
# LIBRAG_ENRICHMENT_MODEL=anthropic/claude-haiku-5-5

# Indexing. A change marks the indexed books out of date.
# LIBRAG_PASSAGE_TARGET_TOKENS=350
# LIBRAG_PASSAGE_OVERLAP_TOKENS=50
# LIBRAG_QDRANT_COLLECTION_PREFIX=passages
# LIBRAG_MAX_UPLOAD_MB=50

# Retrieval.
# LIBRAG_SEARCH_TOP_K=10
# LIBRAG_DENSE_TOP_K=30
# LIBRAG_BM25_TOP_K=30
# LIBRAG_FUSION_TOP_K=30
# LIBRAG_CONTEXT_TOKEN_BUDGET=4000
